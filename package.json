{
  "name": "jhipster-mcp",
  "version": "0.0.5",
  "description": "MCP server that lets AI agents drive the JHipster CLI",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avdev4j/jhipster-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/avdev4j/jhipster-mcp/issues"
  },
  "homepage": "https://github.com/avdev4j/jhipster-mcp#readme",
  "bin": {
    "jhipster-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jhipster",
    "claude",
    "ai",
    "agent",
    "jdl"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
